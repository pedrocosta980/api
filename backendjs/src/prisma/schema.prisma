generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model pacientes {
  id             String   @id @default(uuid())
  nome           String
  dataNascimento DateTime
  carteirinha    String
  cpf            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model medicos {
  id             Int   @unique @id @default(autoincrement())
  nome           String
  crm            String
  ufcrm          String
}
